#define DEBUG

#ifdef DEBUG
#define dprintf if (1) printf
#else
#define dprintf if (0) printf
#endif

static int ospointer_claimed_vectors;


/*******************************************************************
 Function:      Mod_Init
 Description:   Initialise the module workspace, claimed SWI and vectors
 Parameters:    tail = pointer to command line
                podule_base = podule base, or NULL
                pw = module private word
 Returns:       NULL on success, or an error pointer
 ******************************************************************/
_kernel_oserror *Mod_Init(const char *tail, int podule_base, void *pw)
{
    _kernel_oserror *err;

    (void)tail;
    (void)podule_base;

    dprintf("Module OSPointer initialised\n");

    ospointer_pointer_init();
    ospointer_mouse_init();

    err = ospointer_os_claim_ospointer(SWIOSPointer_Entry, pw);
    if (err != NULL)
    {
        return err;
    }

    err = ospointer_os_byte(0x6a, 0, NULL, NULL);
    if (err != NULL)
    {
        ospointer_os_release_ospointer(SWIOSPointer_Entry, pw);
        return err;
    }

    err = ospointer_pointer_mode_change();
    if (err != NULL)
    {
        ospointer_os_release_ospointer(SWIOSPointer_Entry, pw);
        return err;
    }

    err = ospointer_os_claim_vectors(pw);
    if (err != NULL)
    {
        ospointer_os_release_vectors(pw);
        ospointer_os_release_ospointer(SWIOSPointer_Entry, pw);
        return err;
    }
    ospointer_claimed_vectors = 1;

    ospointer_mouse_register_buffer();

    ospointer_pointer_select_mouse_type();

    return NULL;
}


/*******************************************************************
 Function:      Mod_Final
 Description:   Finalise the module and release claimed system state
 Parameters:    fatal = fatality indicator
                podule_base = podule base, or NULL
                pw = module private word
 Returns:       NULL
 ******************************************************************/
_kernel_oserror *Mod_Final(int fatal, int podule_base, void *pw)
{
    (void)fatal;
    (void)podule_base;

    dprintf("Module OSPointer dying\n");

    ospointer_mouse_deregister_buffer();
    if (ospointer_claimed_vectors)
    {
        ospointer_os_release_vectors(pw);
        ospointer_claimed_vectors = 0;
    }
    ospointer_pointer_final();
    ospointer_os_release_ospointer(SWIOSPointer_Entry, pw);

    return NULL;
}


/*******************************************************************
 Function:      Mod_Service
 Description:   Handle mode-change and BufferManager restart services
 Parameters:    service = service reason code
                r = register block
                pw = module private word
 Returns:       none
 ******************************************************************/
void Mod_Service(int service, _kernel_swi_regs *r, void *pw)
{
    (void)r;
    (void)pw;

    if (service == Service_ModeChange)
    {
        ospointer_pointer_mode_change();
    }
    else if (service == Service_DisplayChanged)
    {
        ospointer_pointer_display_changed();
    }
    else if (service == Service_BufferStarting)
    {
        ospointer_mouse_buffer_manager_starting();
    }
}


/*******************************************************************
 Function:      ByteV_Handler
 Description:   Trap OS_Byte 106 pointer selection and INKEY mouse buttons
 Parameters:    r = register block
                pw = module private word
 Returns:       VECTOR_CLAIM if handled, otherwise VECTOR_PASSON
 ******************************************************************/
int ByteV_Handler(_kernel_swi_regs *r, void *pw)
{
    (void)pw;

    if (ospointer_pointer_osbyte(r))
    {
        return VECTOR_CLAIM;
    }

    return VECTOR_PASSON;
}


